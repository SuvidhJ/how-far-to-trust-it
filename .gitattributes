# Normalise line endings. Authored on Windows, run on Linux/macOS too.
* text=auto eol=lf

*.py    text eol=lf
*.md    text eol=lf
*.json  text eol=lf
*.jsonl text eol=lf
*.csv   text eol=lf
*.toml  text eol=lf
*.yaml  text eol=lf
*.yml   text eol=lf
*.sh    text eol=lf
*.ps1   text eol=crlf

*.parquet binary
*.zip     binary
*.png     binary

# Keep golden-set diffs reviewable line-by-line.
data/golden/*.jsonl diff
