# Copy to .env and fill in; .env is gitignored. Keys are only needed for model
# calls that are not already in the committed cache (data/cache/), so
# `harness --offline`, the tests and CI need none of them.

# Free-tier, OpenAI-compatible endpoints (see src/support_agent/llm.py).
MISTRAL_API_KEY=        # embeddings (mistral-embed), ministral-3b annotator
NVIDIA_API_KEY=         # drafter, judge and annotator (build.nvidia.com)
GEMINI_API_KEY=
OPENROUTER_API_KEY=

# Hard ceiling on model calls per process.
LLM_MAX_CALLS_PER_RUN=1200

# scripts/fetch_data.py downloads the raw dump with your Kaggle credentials.
KAGGLE_USERNAME=
KAGGLE_KEY=
